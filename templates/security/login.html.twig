<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Connexion — HANDELNEX</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        :root {
            color: #35445d;
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f7f9;
        }
        * { box-sizing: border-box; }
        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f5f7f9;
        }
        .login-page {
            width: min(100% - 32px, 608px);
            padding: 32px 0 34px;
        }
        .login-card {
            padding: 46px 44px 48px;
            background: #fff;
            border: 1px solid #e3e8ee;
            border-radius: 11px;
            box-shadow: 0 3px 12px rgba(35, 55, 78, .08);
        }
        .field { margin-bottom: 31px; }
        .field-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 15px;
        }
        label, .field-heading a {
            color: #35445d;
            font-size: 17px;
            font-weight: 700;
            letter-spacing: .02em;
        }
        .field-heading a {
            color: #0758e8;
            font-size: 16px;
            text-decoration: none;
            letter-spacing: 0;
        }
        .input-wrap { position: relative; }
        .input-wrap input {
            width: 100%;
            height: 66px;
            padding: 0 54px;
            color: #35445d;
            font: inherit;
            font-size: 19px;
            border: 1px solid #ccd4e2;
            border-radius: 6px;
            outline: 0;
        }
        .input-wrap input::placeholder { color: #a2adbd; opacity: 1; }
        .input-wrap input:focus {
            border-color: #0758e8;
            box-shadow: 0 0 0 2px rgba(7, 88, 232, .12);
        }
        .input-icon, .toggle-password {
            position: absolute;
            top: 50%;
            width: 24px;
            height: 24px;
            color: #8993a4;
            transform: translateY(-50%);
        }
        .input-icon { left: 16px; }
        .toggle-password {
            right: 16px;
            padding: 0;
            border: 0;
            background: transparent;
            cursor: pointer;
        }
        .btn-login {
            width: 100%;
            height: 64px;
            color: #fff;
            background: #0758f5;
            border: 0;
            border-radius: 5px;
            font-size: 20px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 2px 4px rgba(7, 88, 232, .22);
        }
        .btn-login:hover { background: #0048d2; }
        .btn-login svg { margin-left: 9px; vertical-align: -3px; }
        .error-msg {
            margin-bottom: 22px;
            padding: 12px 14px;
            color: #a32937;
            background: #fde7e9;
            border-radius: 5px;
            font-size: 14px;
        }
        @media (max-width: 520px) {
            .login-card { padding: 32px 22px 34px; }
            label, .field-heading a { font-size: 14px; }
            .input-wrap input { height: 58px; font-size: 16px; }
            .btn-login { height: 58px; font-size: 18px; }
        }
    </style>
</head>
<body>
    <main class="login-page">
        <section class="login-card" aria-label="Connexion professionnelle">
            {% if error %}
                <div class="error-msg">Identifiants invalides. Réessayez.</div>
            {% endif %}

            <form method="post">
                <div class="field">
                    <div class="field-heading">
                        <label for="email">EMAIL PROFESSIONNEL</label>
                    </div>
                    <div class="input-wrap">
                        <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"></rect><path d="m4 7 8 6 8-6"></path></svg>
                        <input type="email" id="email" name="_username" value="{{ last_username }}" placeholder="nom@entreprise.com" required autofocus>
                    </div>
                </div>

                <div class="field">
                    <div class="field-heading">
                        <label for="password">MOT DE PASSE</label>
                        <a href="#">Oublié ?</a>
                    </div>
                    <div class="input-wrap">
                        <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="1.5"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
                        <input type="password" id="password" name="_password" placeholder="••••••••" required>
                        <button type="button" class="toggle-password" aria-label="Afficher le mot de passe" aria-pressed="false">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 3l18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.4 5.3A10.6 10.6 0 0 1 12 5c5.5 0 9 5.5 9 7a9.4 9.4 0 0 1-2.4 3.8M6.2 6.2C4.2 7.5 3 10.2 3 12c0 1.5 3.5 7 9 7 1 0 2-.2 2.8-.5"></path></svg>
                        </button>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn-login">Se connecter <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></button>
            </form>

        </section>
    </main>
    <script>
        const password = document.querySelector('#password');
        const toggle = document.querySelector('.toggle-password');
        toggle.addEventListener('click', () => {
            const isVisible = password.type === 'text';
            password.type = isVisible ? 'password' : 'text';
            toggle.setAttribute('aria-pressed', String(!isVisible));
            toggle.setAttribute('aria-label', isVisible ? 'Afficher le mot de passe' : 'Masquer le mot de passe');
        });
    </script>
</body>
</html>
