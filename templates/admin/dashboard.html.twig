{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Tableau de bord{% endblock %}

{% block main %}
<div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:20px; margin-top:10px;">
    <div style="background:#fff; border:1px solid #e4e7f3; border-radius:12px; padding:22px;">
        <div style="font-size:13px; color:#5B6180; text-transform:uppercase; letter-spacing:.05em;">Solutions</div>
        <div style="font-size:32px; font-weight:700; margin-top:6px;">{{ stats.solutions }}</div>
    </div>
    <div style="background:#fff; border:1px solid #e4e7f3; border-radius:12px; padding:22px;">
        <div style="font-size:13px; color:#5B6180; text-transform:uppercase; letter-spacing:.05em;">Actualités</div>
        <div style="font-size:32px; font-weight:700; margin-top:6px;">{{ stats.actualites }}</div>
    </div>
    <div style="background:#fff; border:1px solid #e4e7f3; border-radius:12px; padding:22px;">
        <div style="font-size:13px; color:#5B6180; text-transform:uppercase; letter-spacing:.05em;">Messages reçus</div>
        <div style="font-size:32px; font-weight:700; margin-top:6px;">{{ stats.messages }}</div>
    </div>
    <div style="background:#fff; border:1px solid #C7A25C; border-radius:12px; padding:22px;">
        <div style="font-size:13px; color:#A8813F; text-transform:uppercase; letter-spacing:.05em;">À traiter</div>
        <div style="font-size:32px; font-weight:700; margin-top:6px; color:#A8813F;">{{ stats.messagesNonTraites }}</div>
    </div>
</div>
{% endblock %}
